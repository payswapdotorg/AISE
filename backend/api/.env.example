# AISE backend API — example environment variables.
# Copy to backend/api/.env for local runs (bun loads .env from the working directory).
# These are placeholders with the safe defaults — never real secrets or real values.
# Every variable is optional; the service falls back to documented defaults and
# fails fast at startup when a present value is invalid.

# Bind host (hostname or IP address). Default: 127.0.0.1
HOST=127.0.0.1

# Bind port (integer 1-65535). Default: 8080
PORT=8080

# Log level: debug | info | warn | error. Default: info
LOG_LEVEL=info
