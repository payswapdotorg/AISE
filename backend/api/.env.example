# AISE backend API — example environment variables.
# Copy to backend/api/.env for local runs (bun loads .env from the working directory).
# These are placeholders with the safe defaults — never real secrets or real values.
# Every variable is optional; the service falls back to documented defaults and
# fails fast at startup when a present value is invalid.
#
# NOTE (PROD-001): when you run the ROOT commands (`bun run dev` / `bun run start`
# / `bun run smoke` at the repository root), the ROOT .env file is the canonical
# configuration instead — copy `.env.example` from the repository root. This file
# only applies to direct runs started inside backend/api, where relative
# AISE_DATA_DIR paths resolve against this directory.
#
# NOTE (PROD-003 — production / serverless deployment mode): the deployable API
# is ONE catch-all Vercel function (`api/[[...path]].ts` → vercel.json rewrites
# /healthz, /readyz and /v1/** onto it; everything else serves the static web
# build from apps/web/dist). The SAME runtime pipeline serves `bun run start`
# locally, so every variable below applies to BOTH adapters. The production
# variables are AISE_SERVERLESS, AISE_CORS_ORIGINS and the AISE_DATA_DIR tmp-fs
# default documented below; APP_BASE_URL/API_BASE_URL are the URL conventions
# for local vs hosted configuration (docs/free-tier-deployment.md §Required
# configuration model).

# Bind host (hostname or IP address). LOCAL adapter only — the serverless
# function has no bind address. Default: 127.0.0.1
HOST=127.0.0.1

# Bind port (integer 1-65535). LOCAL adapter only. Default: 8080
PORT=8080

# Log level: debug | info | warn | error. Default: info
LOG_LEVEL=info

# Capture-store root directory (content blobs, session records, idempotency
# ledger). Default: ./data on local runs (resolved against the process working
# directory; the ROOT scripts pass an explicit repository-root-resolved path) —
# REQUIRED (explicitly set) for the production-like `bun run start`.
# SERVERLESS: when AISE_SERVERLESS=1 and this variable is UNSET, the data dir
# defaults to /tmp/aise-data — on Vercel functions /tmp is the ONLY writable
# directory. That tmp dir is EPHEMERAL (fresh on cold starts, per warm
# instance): the API boots and serves read routes honestly, but durable
# artifacts are PROD-006's concern (Cloudflare R2), NOT this filesystem. Set
# AISE_DATA_DIR explicitly only if you mount a writable path.
AISE_DATA_DIR=./data

# PROD-003 — serverless deployment mode: 1|true (0|false to be explicit).
# Marks the Vercel catch-all deployment: no bind address (HOST/PORT unused for
# binding), unset AISE_DATA_DIR → /tmp/aise-data. Unset locally.
# AISE_SERVERLESS=1

# PROD-003 — CORS allowlist: comma-separated absolute http(s) origins that may
# call the API cross-origin (e.g. a dev-time Vite server on another port).
# UNSET (the default) = same-origin only: the web app talks to the API
# same-origin (/healthz /readyz /v1/** rewrite to the function on Vercel), so
# no cross-origin access is granted. Arbitrary origins are NEVER echoed — an
# Origin not on this list gets no CORS headers.
# AISE_CORS_ORIGINS=http://localhost:5173

# URL configuration conventions (docs/free-tier-deployment.md; consumed by the
# web deployment configuration, not by the API process itself):
#   APP_BASE_URL  — the deployed web app origin (e.g. https://aise.example)
#   API_BASE_URL  — the deployed API origin; same-origin by default (the Vercel
#                   rewrites), or an explicit API origin for split deployments.
# Locally: APP_BASE_URL=http://localhost:4173 (vite preview) and the API is
# same-origin through the preview proxy (no API_BASE_URL needed).

# Optional reconstruction provider credential (AISE reconstruction adapter).
# Unset means the provider is cleanly disabled — never required for the local
# runtime. /readyz reports it as "disabled"; set (non-empty) → "available";
# present-but-empty → "unavailable". Never echoed in any response or log.
# WORLDSCULPT_API_KEY=

# Postgres persistence (PROD-005 — Neon). PRESENCE IS THE SWITCH: set → the
# API's wired domain stores (capture, missions, evidence, boq, gaps, cases)
# persist to Postgres and pending migrations run on cold start; unset →
# exactly today's file-system behavior under AISE_DATA_DIR (no database
# needed). Use the Neon POOLED connection string (host contains `-pooler`)
# for serverless deployments. This is a SECRET — never commit the real value.
# DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
