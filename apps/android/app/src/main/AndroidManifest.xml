<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      AISE-002 foundation shipped ZERO permissions by design. AISE-005 adds
      the capture session layer and with it the CAMERA permission — requested
      MISSION-SCOPED at runtime (the capture screen asks when the operator
      starts using capture, it is never blanket-granted). Deliberately NOT
      requested: location (optional per the work order; AISE-009 decides),
      RECORD_AUDIO (video is visual evidence only — no microphone), network
      (offline-first; sync is AISE-030 behind its own boundary).
    -->

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Capability-aware: camera-less devices can still install the app
         (manual measurements arrive with AISE-009); capture is simply
         unavailable — an honest capability fact, not an install barrier. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".AiseApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiseField">

        <!-- POST-005: launchMode singleTask so a handed-off task deep link
             always routes into the EXISTING task's activity (onNewIntent)
             instead of stacking a second capture task on the back stack. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AiseField">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- POST-005: the cross-device field task handoff entry point —
                 the aise://task deep link the web capture/case/outcome
                 surfaces emit (the committed capability fixture's declared
                 scheme). Parsing and continuation are :core-pure
                 (FieldTaskDeepLink) and honestly badged; no data crosses
                 here beyond the typed task identity envelope. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aise" android:host="task" />
            </intent-filter>
        </activity>
    </application>

</manifest>
