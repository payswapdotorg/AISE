{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "campaign", "governingArchitecture", "implementationCampaign", "productization", "execution", "workItems"],
  "properties": {
    "schemaVersion": {"const": 1},
    "campaign": {"const": "AISE-productization"},
    "governingArchitecture": {"type":"string","pattern":"^2\\.2( \\+ ACR-[0-9]{3})*$"},
    "architectureChangeRecords": {"type":"array","items":{"type":"string"}},
    "technologySubstitutionContract": {"type":"string"},
    "implementationCampaign": {"type": "object"},
    "productization": {"type": "object"},
    "execution": {"type": "object"},
    "workItems": {"type": "array"}
  }
}
