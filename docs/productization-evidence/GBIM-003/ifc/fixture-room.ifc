ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('GBIM-003 spike: IFC4 interop projection of the GBIM-000 canonical fixture (8x6x3 m room, 200 mm wall, 0.9x2.1 m door, 1.2x1.2 m window, 300 mm column, 200 mm slab, 400x400x300 mm footing, 250x400 mm beam, 150 mm partition)'),'2;1');
FILE_NAME('fixture-room.ifc','2026-09-25T00:00:00Z',('GBIM-003 spike worker'),('AISE spike evidence'),('web-ifc lane','AISE Spatial Studio spike');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* fixture: GBIM-000-building-001 (AISE-owned canonical fixture) — sha-256 recorded in results/spike-results.json */
#1=IFCPROJECT('0GBIM003PROJ0000000001',$,'GBIM-000 fixture room (AISE spike projection)','Spike interop projection of the pinned AISE canonical fixture',$,$,$,(#20),#11);
#11=IFCUNITASSIGNMENT((#12,#13,#14,#15));
#12=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#13=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#14=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#15=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21=IFCAXIS2PLACEMENT3D(#22,$,$);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#30=IFCSITE('0GBIM003SITE00000000001',$,'Fixture site',$,$,#31,$,$,.ELEMENT.,$,$,0.,$,$);
#31=IFCLOCALPLACEMENT($,#21);
#40=IFCBUILDING('0GBIM003BLDG00000000001',$,'Fixture building',$,$,#41,$,$,.ELEMENT.,$,$,$);
#41=IFCLOCALPLACEMENT(#31,#21);
#50=IFCBUILDINGSTOREY('0GBIM003STRY00000000001',$,'Ground floor',$,$,#51,$,$,.ELEMENT.,0.);
#51=IFCLOCALPLACEMENT(#41,#21);
/* wall-001: 8 m wall, 200 mm thick, 3 m high (IFC X along wall) */
#100=IFCWALLSTANDARDCASE('0GBIM003WALL00000000001',$,'wall-001',$,$,#101,#110,'wall-001',$);
#101=IFCLOCALPLACEMENT(#51,#102);
#102=IFCAXIS2PLACEMENT3D(#103,$,$);
#103=IFCCARTESIANPOINT((-4.,2.9,0.));
#110=IFCPRODUCTDEFINITIONSHAPE($,$,(#111));
#111=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#112));
#112=IFCEXTRUDEDAREASOLID(#113,#21,$,#117,3.);
#113=IFCRECTANGLEPROFILEDEF(.AREA.,'wall-001 profile',#114,8.,0.2);
#114=IFCAXIS2PLACEMENT2D(#115,$);
#115=IFCCARTESIANPOINT((0.,0.));
#117=IFCDIRECTION((0.,0.,1.));
/* opening-door-001: 0.9 x 2.1 m, sill 0 */
#120=IFCOPENINGELEMENT('0GBIM003OPEN000DR000001',$,'opening-door-001',$,$,#121,#130,'opening-door-001',$);
#121=IFCLOCALPLACEMENT(#101,#122);
#122=IFCAXIS2PLACEMENT3D(#123,$,$);
#123=IFCCARTESIANPOINT((-2.,0.,0.));
#130=IFCPRODUCTDEFINITIONSHAPE($,$,(#131));
#131=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#132));
#132=IFCEXTRUDEDAREASOLID(#133,#21,$,#117,2.1);
#133=IFCRECTANGLEPROFILEDEF(.AREA.,'door opening profile',#114,0.9,0.25);
#140=IFCRELVOIDSELEMENT('0GBIM003RELV000DR0000001',$,$,$,#100,#120);
/* opening-window-001: 1.2 x 1.2 m, sill 0.9 */
#150=IFCOPENINGELEMENT('0GBIM003OPEN000WN000001',$,'opening-window-001',$,$,#151,#160,'opening-window-001',$);
#151=IFCLOCALPLACEMENT(#101,#152);
#152=IFCAXIS2PLACEMENT3D(#153,$,$);
#153=IFCCARTESIANPOINT((1.5,0.,0.9));
#160=IFCPRODUCTDEFINITIONSHAPE($,$,(#161));
#161=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#162));
#162=IFCEXTRUDEDAREASOLID(#163,#21,$,#117,1.2);
#163=IFCRECTANGLEPROFILEDEF(.AREA.,'window opening profile',#114,1.2,0.25);
#170=IFCRELVOIDSELEMENT('0GBIM003RELV000WN000001',$,$,$,#100,#150);
/* door leaf + window frame (fillings — note: create-door/create-window have IFC types but NO Phase 1 AISE engine type) */
#180=IFCDOOR('0GBIM003DOOR00000000001',$,'opening-door-001 leaf',$,$,#121,#181,'opening-door-001 leaf',2.1,0.9,.DOOR.,.SINGLE_SWING_LEFT.,$);
#181=IFCPRODUCTDEFINITIONSHAPE($,$,(#131));
#190=IFCRELFILLSELEMENT('0GBIM003RELF000DR0000001',$,$,$,#120,#180);
#200=IFCWINDOW('0GBIM003WIND00000000001',$,'opening-window-001 frame',$,$,#151,#201,'opening-window-001 frame',1.2,1.2,.WINDOW.,.SINGLE_PANEL.,$);
#201=IFCPRODUCTDEFINITIONSHAPE($,$,(#161));
#210=IFCRELFILLSELEMENT('0GBIM003RELF000WN000001',$,$,$,#150,#200);
/* slab-001: 8 x 6 m, 200 mm */
#220=IFCSLAB('0GBIM003SLAB00000000001',$,'slab-001',$,$,#221,#230,'slab-001',.FLOOR.);
#221=IFCLOCALPLACEMENT(#51,#222);
#222=IFCAXIS2PLACEMENT3D(#223,$,$);
#223=IFCCARTESIANPOINT((-4.,-3.,-0.2));
#230=IFCPRODUCTDEFINITIONSHAPE($,$,(#231));
#231=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#232));
#232=IFCEXTRUDEDAREASOLID(#233,#21,$,#117,0.2);
#233=IFCRECTANGLEPROFILEDEF(.AREA.,'slab-001 profile',#114,8.,6.);
/* column-001: 300 x 300 mm */
#240=IFCCOLUMN('0GBIM003COLU00000000001',$,'column-001',$,$,#241,#250,'column-001',$);
#241=IFCLOCALPLACEMENT(#51,#242);
#242=IFCAXIS2PLACEMENT3D(#243,$,$);
#243=IFCCARTESIANPOINT((3.35,-2.65,0.));
#250=IFCPRODUCTDEFINITIONSHAPE($,$,(#251));
#251=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#252));
#252=IFCEXTRUDEDAREASOLID(#253,#21,$,#117,3.);
#253=IFCRECTANGLEPROFILEDEF(.AREA.,'column-001 profile',#114,0.3,0.3);
/* footing-001: 400 x 400 x 300 mm under the column */
#260=IFCFOOTING('0GBIM003FOOT00000000001',$,'footing-001',$,$,#261,#270,'footing-001',.PAD_FOOTING.);
#261=IFCLOCALPLACEMENT(#51,#262);
#262=IFCAXIS2PLACEMENT3D(#263,$,$);
#263=IFCCARTESIANPOINT((3.3,-2.7,-0.5));
#270=IFCPRODUCTDEFINITIONSHAPE($,$,(#271));
#271=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#272));
#272=IFCEXTRUDEDAREASOLID(#273,#21,$,#117,0.3);
#273=IFCRECTANGLEPROFILEDEF(.AREA.,'footing-001 profile',#114,0.4,0.4);
/* beam-001: 250 x 400 mm spanning Z (6 m) at X=-3.5 near the top */
#280=IFCBEAM('0GBIM003BEAM00000000001',$,'beam-001',$,$,#281,#290,'beam-001',$);
#281=IFCLOCALPLACEMENT(#51,#282);
#282=IFCAXIS2PLACEMENT3D(#283,$,$);
#283=IFCCARTESIANPOINT((-3.625,-3.,2.6));
#290=IFCPRODUCTDEFINITIONSHAPE($,$,(#291));
#291=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#292));
#292=IFCEXTRUDEDAREASOLID(#293,#294,$,#297,6.);
#293=IFCRECTANGLEPROFILEDEF(.AREA.,'beam-001 profile',#114,0.4,0.25);
#294=IFCAXIS2PLACEMENT3D(#295,$,$);
#295=IFCCARTESIANPOINT((0.,0.,0.));
#297=IFCDIRECTION((0.,1.,0.));
/* partition-001: 150 mm internal partition spanning Z (6 m) */
#300=IFCWALL('0GBIM003PART00000000001',$,'partition-001',$,$,#301,#310,'partition-001',$);
#301=IFCLOCALPLACEMENT(#51,#302);
#302=IFCAXIS2PLACEMENT3D(#303,$,$);
#303=IFCCARTESIANPOINT((-0.075,-3.,0.));
#310=IFCPRODUCTDEFINITIONSHAPE($,$,(#311));
#311=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#312));
#312=IFCEXTRUDEDAREASOLID(#313,#314,$,#117,3.);
#313=IFCRECTANGLEPROFILEDEF(.AREA.,'partition-001 profile',#114,0.15,6.);
#314=IFCAXIS2PLACEMENT3D(#315,$,$);
#315=IFCCARTESIANPOINT((0.,0.,0.));
/* roof-001: plane (thin slab at 3.05) */
#320=IFCSLAB('0GBIM003ROOF00000000001',$,'roof-001',$,$,#321,#330,'roof-001',.ROOF.);
#321=IFCLOCALPLACEMENT(#51,#322);
#322=IFCAXIS2PLACEMENT3D(#323,$,$);
#323=IFCCARTESIANPOINT((-4.,-3.,3.05));
#330=IFCPRODUCTDEFINITIONSHAPE($,$,(#331));
#331=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#332));
#332=IFCEXTRUDEDAREASOLID(#333,#21,$,#117,0.05);
#333=IFCRECTANGLEPROFILEDEF(.AREA.,'roof-001 profile',#114,8.,6.);
/* spatial containment */
#340=IFCRELAGGREGATES('0GBIM003AGGR000000000001',$,$,$,#1,(#30));
#341=IFCRELAGGREGATES('0GBIM003AGGR000000000002',$,$,$,#30,(#40));
#342=IFCRELAGGREGATES('0GBIM003AGGR000000000003',$,$,$,#40,(#50));
#343=IFCRELCONTAINEDINSPATIALSTRUCTURE('0GBIM003RCS000000000001',$,$,$,(#100,#220,#240,#260,#280,#300,#320),#50);
ENDSEC;
END-ISO-10303-21;
