# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo
.vite/

# Runtime data — default AISE_DATA_DIR location for the root scripts
# (see docs/INSTALL.md; PROD-001)
data/

# Environment — real env files are never committed; only .env.example is.
.env
.env.*
!.env.example

# Logs and OS noise
*.log
.DS_Store

# Vercel — local project link + pulled settings + local build output
# (the project link is machine-local; secrets pulled by `vercel pull` are
# never committed). NOTE: api/[...path].mjs IS committed — it is the
# deploy beacon Vercel's zero-config/functions scan needs PRE-build; every
# build regenerates it deterministically (tools/build.ts).
.vercel/
