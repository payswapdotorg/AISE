# AISE root environment — copy to `.env` at the repository root.
#
# Bun automatically loads a root `.env` file when you run root scripts
# (bun run dev / start / smoke / check:env). Real credentials never belong in
# Git — `.gitignore` already excludes `.env` and `.env.*`.
#
# Validate any time with: bun run check:env

# --- Backend API (backend/api — AISE-001/AISE-004 contract) -----------------
# HOST=127.0.0.1
# PORT=8080
# LOG_LEVEL=info
# AISE_DATA_DIR=./data

# AISE_DATA_DIR is REQUIRED for the production-like start (`bun run start`)
# and optional in development (`bun run dev`, default ./data resolved against
# the repository root).

# --- Web workspace (apps/web/vite.config.ts) --------------------------------
# AISE_WEB_PORT=5173

# --- Optional provider credentials (missing = cleanly disabled, never an error) ---
# WORLDSCULPT_API_KEY=

# --- NOT YET CONSUMED by the current runtime --------------------------------
# Future productization items will read these; see docs/free-tier-deployment.md.
# They are listed so operators can see the full planned surface. Do NOT set
# them expecting behavior today.
# DATABASE_URL=               # PROD-005 — Neon Postgres
# REDIS_URL=                  # PROD-007 — Upstash Redis
# UPSTASH_REDIS_REST_URL=     # PROD-007 — Upstash Redis REST
# R2_ACCOUNT_ID=              # PROD-006 — Cloudflare R2
# R2_BUCKET=                  # PROD-006 — Cloudflare R2
# R2_ACCESS_KEY_ID=           # PROD-006 — Cloudflare R2
# R2_SECRET_ACCESS_KEY=       # PROD-006 — Cloudflare R2
# APIFY_TOKEN=                # PROD-008 — optional Apify acquisition connector
