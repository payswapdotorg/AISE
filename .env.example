# AISE runtime configuration template.
#
# Copy this file to `.env` for local development. `.env` is gitignored and
# MUST never be committed. Services fail closed (exit code 1, structured
# error) when required configuration is missing or invalid.
#
# Required (no default — services refuse to guess):
AISE_ENV=development

# Optional (defaults shown):
# AISE_LOG_LEVEL=info            # debug | info | warn | error
# AISE_API_HOST=127.0.0.1
# AISE_API_PORT=8080
# AISE_WORKER_POLL_INTERVAL_MS=1000

# Secrets note: the foundation defines no secret values yet. When later
# Work Items introduce them (e.g. AISE-004 capture API auth), they are
# provided via environment variables only — never committed to source.
