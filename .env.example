# AISE root environment — copy to `.env` at the repository root.
#
# Bun automatically loads a root `.env` file when you run root scripts
# (bun run dev / start / smoke / check:env). Real credentials never belong in
# Git — `.gitignore` already excludes `.env` and `.env.*`.
#
# Validate any time with: bun run check:env

# --- Backend API (backend/api — AISE-001/AISE-004 contract) -----------------
# HOST=127.0.0.1
# PORT=8080
# LOG_LEVEL=info
# AISE_DATA_DIR=./data

# AISE_DATA_DIR is REQUIRED for the production-like start (`bun run start`)
# and optional in development (`bun run dev`, default ./data resolved against
# the repository root).

# --- Web workspace (apps/web/vite.config.ts) --------------------------------
# AISE_WEB_PORT=5173

# --- Optional provider credentials (missing = cleanly disabled, never an error) ---
# WORLDSCULPT_API_KEY=

# --- Auth / tenant safety (PROD-004 — backend/api auth layer) ----------------
# AISE_AUTH enables the request-authentication + tenant-scoping layer at the
# runtime seam. UNSET or 0 = disabled (zero behavior change — /v1 is served
# exactly as before). 1 = enabled (recommended for deployments; the web shell
# then shows the sign-in / "Enter demo" gate).
# AISE_AUTH=1

# REQUIRED when AISE_AUTH=1 (check:env fails deterministically without it):
# the HMAC key for session tokens. Generate one with, for example,
#   bun -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# Never commit real secrets — .gitignore already excludes .env / .env.*.
# AUTH_SECRET=

# Auth mode: required (every /v1 request needs a session) | demo-open (default:
# anonymous READS of the demo tenant's projects are allowed so evaluators see
# content; writes always require a session).
# AISE_AUTH_MODE=demo-open

# Session lifetime in seconds (60..2592000; default 604800 = 7 days).
# AISE_SESSION_TTL_SECONDS=604800

# The deterministic demo principal id that "Enter demo" mints a session for
# (bound to the fixed demo tenant org-northwind ONLY).
# AISE_DEMO_PRINCIPAL=demo-evaluator
# --- PROD-006: Cloudflare R2 artifact storage (optional group, all-or-nothing) ---
# Set ALL FOUR required members to activate durable R2 blob storage for
# /v1/artifacts (BOQs, images, videos, captures, derived artifacts); leave
# ALL unset for the local-fs development twin (readiness honestly reports
# `artifacts: {backend: "local-fs"}` — durable artifacts REQUIRE this group
# in deployment). A HALF-CONFIGURED group is a deterministic configuration
# error (bun run check:env) and the API serves 503s on artifact routes
# instead of silently falling back. Values are never echoed anywhere.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional explicit endpoint override (defaults to
# https://<account>.r2.cloudflarestorage.com — path-style S3-compatible API):
# R2_PUBLIC_ENDPOINT=

# PROD-006: artifact upload size cap in bytes (default 26214400 = 25 MiB).
# Large uploads are bounded and REJECTED (413), never truncated.
# AISE_ARTIFACT_MAX_BYTES=26214400
# --- Postgres persistence (PROD-005 — Neon) ----------------------------------
# PRESENCE IS THE SWITCH: when DATABASE_URL is set, the API's wired domain
# stores (capture, missions, evidence, boq, gaps, cases) persist to Postgres
# (Neon) instead of the local file-system stores; when unset, the API runs
# EXACTLY as before (file-system stores under AISE_DATA_DIR — no database
# needed). Migrations run automatically on cold start; `bun run db:migrate`
# and `bun run db:seed` are the explicit operators.
#
# Use the Neon POOLED connection string (host contains `-pooler`) for
# serverless deployments. This is a SECRET: never commit the real value —
# .gitignore already excludes .env / .env.*.
# DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- NOT YET CONSUMED by the current runtime --------------------------------
# Future productization items will read these; see docs/free-tier-deployment.md.
# They are listed so operators can see the full planned surface. Do NOT set
# them expecting behavior today.
# REDIS_URL=                  # PROD-007 — Upstash Redis
# UPSTASH_REDIS_REST_URL=     # PROD-007 — Upstash Redis REST
# APIFY_TOKEN=                # PROD-008 — optional Apify acquisition connector
