{
  "name": "aise",
  "version": "0.0.0",
  "private": true,
  "description": "AI Site Engineer — cross-platform Reality-to-Engineering platform (workspace root)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend/packages/*",
    "backend/services/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @aise/backend-api",
    "dev:worker": "npm run dev --workspace @aise/backend-worker",
    "dev:web": "npm run dev --workspace @aise/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "tsx scripts/smoke-foundation.ts",
    "build:web": "npm run build --workspace @aise/web",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run smoke && npm run build:web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
