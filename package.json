{
  "name": "aise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AISE v2 monorepo — repository, runtime and CI foundation. See README.md, AGENTS.md and spec/ for governance.",
  "workspaces": [
    "apps/*",
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "verify": "bun tools/verify.ts",
    "typecheck": "bun tools/verify.ts typecheck",
    "lint": "bun tools/verify.ts lint",
    "test": "bun test",
    "check:env": "bun tools/validate-env.ts",
    "dev": "bun tools/dev.ts",
    "build": "bun tools/build.ts",
    "start": "bun tools/start.ts",
    "smoke": "bun tools/smoke.ts",
    "db:migrate": "bun tools/db-migrate.ts",
    "db:seed": "bun tools/db-seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "playwright": "1.58.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@aise/api": "workspace:*",
    "@aise/shared-contracts": "workspace:*"
  }
}