              "mediaType": {
                "description": "IANA-style media type of the content.",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+-]{0,126}\\/[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+-]{0,126}$",
                "type": "string"
