                  "VISUAL_RECONSTRUCTION",
                  "CALIBRATED_REFERENCE",
                  "MANUAL_MEASUREMENT",
                  "SPECIALIST_INSTRUMENT",
                  "VIDEO_FOOTAGE",
                  "STILL_IMAGERY",
